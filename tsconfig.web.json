{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "emitDeclarationOnly": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "outDir": "dist/.ts-web"
  },
  "include": ["src/web", "src/shared"]
}
