{
  "name": "gaffur",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "npm run build && npm run build:node && npm run start:node",
    "build:node": "esbuild src/server/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/server/index.mjs --packages=external",
    "start:node": "node dist/server/index.mjs",
    "test": "vitest run",
    "probe": "tsx scripts/probe.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
