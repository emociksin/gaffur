{
  "name": "gaffur",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "start": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply gaffur-db --local",
    "db:remote": "wrangler d1 migrations apply gaffur-db --remote",
    "probe": "tsx scripts/probe.ts"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "wrangler": "^4.20.0"
  }
}
